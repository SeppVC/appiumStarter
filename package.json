{
  "name": "appium-training-starter",
  "version": "1.0.0",
  "description": "Starter project for the Appium training: WebdriverIO + Appium + TypeScript on the WebdriverIO native demo app",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "postinstall": "node scripts/download-app.mjs",
    "download:app": "node scripts/download-app.mjs",
    "test": "wdio run config/wdio.android.conf.ts --exclude test/specs/lab.spec.ts",
    "test:login": "wdio run config/wdio.android.conf.ts --spec test/specs/login.spec.ts",
    "test:example": "wdio run config/wdio.android.conf.ts --spec test/specs/example.spec.ts",
    "test:lab":"wdio run config/wdio.android.conf.ts --spec test/specs/lab.spec.ts",
    "test:bs": "wdio run config/wdio.browserstack.conf.ts --exclude test/specs/lab.spec.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@wdio/appium-service": "^9.32.0",
    "@wdio/browserstack-service": "^9.41.0",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "edgedriver@6.3.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "geckodriver@6.1.1": true,
    "protobufjs@7.6.6": true
  }
}
